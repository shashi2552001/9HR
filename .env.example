# Application Environment Configuration — 9HR India Enterprise HRMS Portal
# Note: Cloud SQL runtime credentials (SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME,
# SQL_ADMIN_USER, SQL_ADMIN_PASSWORD) are automatically injected by the platform.

APP_URL="https://portal.9hrindia.com"

# Cryptographic secrets (generate strong 32+ char random strings for production)
SESSION_SECRET="REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET"
FILE_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_HEX_AES256_KEY"
DOWNLOAD_TOKEN_SECRET="REPLACE_WITH_SECURE_DOWNLOAD_SIGNING_SECRET"

# Initial Super Admin bootstrap (used by seed script / initial setup; never hardcode prod secrets)
INITIAL_SUPERADMIN_EMAIL="superadmin@9hrindia.com"
INITIAL_SUPERADMIN_PASSWORD=""

# Optional SMTP Configuration for Email Notifications & OTP Delivery
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="9HR India Portal <noreply@9hrindia.com>"

# Optional WhatsApp Business Cloud API (when unconfigured, portal uses WhatsApp Web share links)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
